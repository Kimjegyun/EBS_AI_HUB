# ── 서버 기본 설정 ─────────────────────────────────────────────────────────────
PORT=3001

# 개발 모드(로컬 전용): 127.0.0.1
# 배포 모드(외부 접근): 0.0.0.0  (SERVE_STATIC=true 시 자동으로 0.0.0.0 사용)
HOST=127.0.0.1

CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://localhost:5173,https://localhost:5174

# Required for local JWT login. Do not use default-secret.
JWT_SECRET=

# Required for admin login gate. This value is never sent to the browser.
# Also used as the shared bearer token for the inventory API (VITE_INVENTORY_TOKEN on the client).
ADMIN_ACCESS_CODE=

# ── 배포 모드 설정 ─────────────────────────────────────────────────────────────
# 빌드된 프론트엔드를 Express가 직접 서빙할 때 true로 설정
# (npm run serve 명령어가 자동으로 이 값을 설정함)
# SERVE_STATIC=true

# 외부 공개 URL (핸드폰 QR에 사용, CORS 허용 목록에도 추가됨)
# 예: http://your-server-ip:3001  또는  https://your-domain.com
# PUBLIC_URL=http://your-server-ip:3001
