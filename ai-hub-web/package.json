{
    "name":  "ai-hub-web",
    "private":  true,
    "version":  "0.0.0",
    "type":  "module",
    "scripts":  {
                    "test:resources": "node server/node_modules/tsx/dist/cli.mjs --test scripts/resource-execution.test.ts scripts/safe-workbook.test.ts",
                    "test:resources": "node server/node_modules/tsx/dist/cli.mjs --test scripts/resource-execution.test.ts scripts/safe-workbook.test.ts",
                    "import:programs":  "node scripts/import-programs.mjs",
                    "test:imports":  "node --test scripts/import-programs.test.mjs",
                    "dev":  "vite",
                    "dev:user":  "vite --mode user --host 127.0.0.1 --port 5173 --strictPort",
                    "dev:admin":  "vite --mode admin --host 127.0.0.1 --port 5174 --strictPort",
                    "dev:log":  "vite --mode log --host 127.0.0.1 --port 5175 --strictPort",
                    "dev:all":  "powershell -ExecutionPolicy Bypass -File scripts/dev-all.ps1",
                    "start:aihub":  "powershell -ExecutionPolicy Bypass -File scripts/start-aihub.ps1",
                    "start:aihub:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-aihub-dev.ps1",
                    "install:aihub:dev:auto-start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-aihub-dev-auto-start.ps1",
                    "portals:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/get-public-portals-status.ps1",
                    "portals:autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-public-portals-auto-start.ps1",
                    "portals:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-public-portals-shortcut.ps1",
                    "build":  "tsc -b \u0026\u0026 vite build",
                    "build:prod":  "tsc -b \u0026\u0026 vite build --mode production",
                    "serve":  "npm run build:prod \u0026\u0026 npm run server:build \u0026\u0026 npm run serve:only",
                    "server:build":  "npm run build --prefix server",
                    "serve:only":  "cross-env NODE_ENV=production SERVE_STATIC=true node server/dist/index.js",
                    "lint":  "eslint .",
                    "preview":  "vite preview",
                    "trust-https":  "node scripts/trust-local-https.mjs",
                    "tunnel:setup":  "powershell -ExecutionPolicy Bypass -File scripts/setup-cloudflare-tunnel.ps1",
                    "tunnel:start":  "powershell -ExecutionPolicy Bypass -File scripts/start-cloudflare-tunnel.ps1",
                    "tunnel:quick":  "powershell -ExecutionPolicy Bypass -File scripts/start-cloudflare-quick-tunnel.ps1",
                    "inventory:autostart":  "powershell -ExecutionPolicy Bypass -File scripts/install-inventory-auto-start.ps1",
                    "tencent:create-token":  "node scripts/create-tencent-aigc-token.mjs",
                    "tencent:show-token":  "node scripts/show-tencent-aigc-token.mjs",
                    "verify:production-feedback":  "npm run test:portals \u0026\u0026 node scripts/portal-login-browser-harness.mjs \u0026\u0026 node --test scripts/security-hardening.test.mjs \u0026\u0026 node --test scripts/portal-backend-recovery.test.mjs && node --test scripts/portal-identity-transport.test.mjs scripts/portal-refresh.test.mjs scripts/portal-membership.test.mjs scripts/portal-membership-latency.test.mjs",
                    "test:portals":  "node --test scripts/portal-proxy.test.mjs scripts/portal-legacy-routes.test.mjs scripts/google-login-return-to.test.mjs scripts/login-role-policy.test.mjs scripts/verify-development-target.test.mjs scripts/admin-permission-group.test.mjs",
                    "test:security":  "node --test scripts/security-regressions.test.mjs scripts/google-profile.test.mjs scripts/google-approval.test.mjs scripts/security-hardening.test.mjs"
                },
    "dependencies":  {
                         "@supabase/supabase-js":  "^2.105.3",
                         "@tesseract.js-data/eng":  "^1.0.0",
                         "@types/qrcode":  "^1.5.6",
                         "@types/react-grid-layout":  "^1.3.6",
                         "barcode-detector":  "^3.2.2",
                         "docx":  "^9.7.1",
                         "exceljs":  "^4.4.0",
                         "file-saver":  "^2.0.5",
                         "html-to-image":  "^1.11.13",
                         "html5-qrcode":  "^2.3.8",
                         "jspdf":  "^4.2.1",
                         "mammoth":  "^1.12.1",
                         "pdfjs-dist":  "^6.2.108",
                         "qrcode":  "^1.5.4",
                         "react":  "^19.2.5",
                         "react-dom":  "^19.2.5",
                         "react-grid-layout":  "^1.4.4",
                         "react-router-dom":  "^7.15.0",
                         "tesseract.js":  "^7.0.0",
                         "xlsx":  "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
                         "zxing-wasm":  "^3.1.3"
                     },
    "devDependencies":  {
                            "@electric-sql/pglite":  "^0.5.10",
                            "@eslint/js":  "^10.0.1",
                            "@tailwindcss/forms":  "^0.5.11",
                            "@tailwindcss/postcss":  "^4.3.3",
                            "@types/file-saver":  "^2.0.7",
                            "@types/node":  "^24.12.2",
                            "@types/react":  "^19.2.14",
                            "@types/react-dom":  "^19.2.3",
                            "@vitejs/plugin-react":  "^6.0.1",
                            "autoprefixer":  "^10.5.0",
                            "cross-env":  "^10.1.0",
                            "eslint":  "^10.2.1",
                            "eslint-plugin-react-hooks":  "^7.1.1",
                            "eslint-plugin-react-refresh":  "^0.5.2",
                            "globals":  "^17.5.0",
                            "postcss":  "^8.5.14",
                            "tailwindcss":  "^4.3.3",
                            "typescript":  "~6.0.2",
                            "typescript-eslint":  "^8.58.2",
                            "vite":  "^8.0.10",
                            "vite-plugin-mkcert":  "^1.17.12"
                        },
    "overrides":  {
                      "uuid":  "^11.1.1"
                  }
}
